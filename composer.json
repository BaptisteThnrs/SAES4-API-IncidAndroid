{
    "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/the-yasmf-project/yasmf"
    }
  ],
  "autoload": {
      "psr-4": {
        "API\\": "API/",
        "fonction\\": "fonction/",
        "controllers\\" : "controllers/",
        "application\\" : "application/",
        "model\\":"model/",
        "views\\" : "views/"
      }
    },
  
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "10.0.*",
        "yasmf/yasmf": ">=1.6.1"
    },
  "require": {
    "ext-pdo": "*"
  }
}
